{
  "name": "dsh-arbiter",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic command rules plus real auto review for DeepSeek Harness.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.cjs"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "clean": "node scripts/clean.ts",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node scripts/build-client.ts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run lint:code && pnpm run lint:testing-library",
    "lint:code": "eslint . --max-warnings=0",
    "lint:testing-library": "eslint --config eslint.testing-library.config.mjs tests/client tests/helpers/render-client.tsx --max-warnings=0",
    "lint:fix": "pnpm run lint:testing-library --fix && pnpm run lint:code --fix && pnpm run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:ui",
    "test:watch": "vitest",
    "check:unused": "knip",
    "check:workflows": "actionlint && zizmor --offline --no-progress --strict-collection .github",
    "check:build": "node scripts/check-build.ts",
    "verify": "pnpm run check:peers && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:unused && pnpm run check:dependencies && pnpm run check:workflows && pnpm run check:i18n && pnpm run test && pnpm run build && pnpm run check:build && pnpm run check:regressions",
    "check:regressions": "node scripts/check-regressions.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:ui": "vitest run --project ui",
    "test:e2e:dsh": "pnpm build && playwright test",
    "check:i18n": "node scripts/check-i18n.ts",
    "check:i18n:release": "node scripts/check-i18n.ts --release",
    "check:release": "pnpm check:i18n:release && pnpm verify && pnpm test:e2e:dsh",
    "check:peers": "pnpm peers check",
    "test:coverage": "vitest run --coverage",
    "check:dependencies": "depcruise --config dependency-cruiser.config.mjs src"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.6.5",
    "@types/picomatch": "4.0.2",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "18.7.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "knip": "6.42.0",
    "msw": "3.0.3",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "picomatch": "4.0.7",
    "re2js": "2.8.8",
    "tokenx": "2.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
