{
  "name": "dsh-arbiter",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic command rules plus real auto review for DeepSeek Harness.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "clean": "node scripts/clean.ts",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && node scripts/build-client.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:unused": "knip",
    "check:workflows": "actionlint",
    "check:build": "node scripts/check-build.ts",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:unused && pnpm run check:workflows && pnpm run test && pnpm run build && pnpm run check:build && pnpm run check:regressions",
    "check:regressions": "node validation/codex-review/2026-10-21/reproduce.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/picomatch": "4.0.2",
    "@types/react": "18.3.27",
    "@vitest/eslint-plugin": "1.6.27",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "knip": "6.42.0",
    "prettier": "3.9.10",
    "react": "18.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "picomatch": "4.0.7",
    "re2js": "2.8.8",
    "tokenx": "2.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
