[
  {
    "id": "g4-a-mcp-direct-allow",
    "group": "4",
    "title": "MCP 工具直接调用 allow：server 收到 tools/call",
    "task": "HOSTCOV G4-A mcp direct allow",
    "mcpServerName": "hostcov",
    "approvalPolicy": "ask",
    "rules": [
      {
        "id": "g4-mcp-allow",
        "tool": "mcp__hostcov__echo_marker",
        "contains": "G4A",
        "action": "allow"
      }
    ],
    "scenario": {
      "default": [
        {
          "type": "calls",
          "calls": [
            {
              "name": "mcp__hostcov__echo_marker",
              "arguments": {
                "marker": "G4A"
              }
            }
          ]
        },
        {
          "type": "text",
          "text": "G4A-DONE"
        }
      ]
    }
  },
  {
    "id": "g4-b-mcp-direct-deny",
    "group": "4",
    "title": "MCP 工具直接调用 deny：server 未收到 tools/call（RPC 未发出）",
    "task": "HOSTCOV G4-B mcp direct deny",
    "mcpServerName": "hostcov",
    "approvalPolicy": "ask",
    "rules": [
      {
        "id": "g4-mcp-deny",
        "tool": "mcp__hostcov__echo_marker",
        "contains": "G4B",
        "action": "deny",
        "reason": "hostcov fixture: MCP tool denied"
      }
    ],
    "scenario": {
      "default": [
        {
          "type": "calls",
          "calls": [
            {
              "name": "mcp__hostcov__echo_marker",
              "arguments": {
                "marker": "G4B"
              }
            }
          ]
        },
        {
          "type": "text",
          "text": "G4B-DONE"
        }
      ]
    }
  },
  {
    "id": "g4-c-mcp-inside-run-code",
    "group": "4",
    "title": "run_code 内调用 MCP：放行一个、拒绝一个，核对 server 收件",
    "task": "HOSTCOV G4-C mcp inner",
    "mcpServerName": "hostcov",
    "toolsMode": "ptc",
    "approvalPolicy": "ask",
    "rules": [
      {
        "id": "g4-mcp-inner-deny",
        "tool": "mcp__hostcov__write_receipt",
        "contains": "G4C-DENY",
        "action": "deny",
        "reason": "hostcov fixture: MCP inner denied"
      }
    ],
    "scenario": {
      "default": [
        {
          "type": "calls",
          "calls": [
            {
              "name": "run_code",
              "arguments": {
                "description": "g4 mcp inside run_code",
                "code": "\nconst ok = await tools.mcp__hostcov__echo_marker({ marker: \"G4C-ALLOW\" });\nlet denied = null;\ntry {\n  await tools.mcp__hostcov__write_receipt({ marker: \"G4C-DENY\" });\n} catch (error) {\n  denied = { toolName: error?.toolName ?? null, message: String(error?.message ?? error) };\n}\nreturn { ok, denied };"
              }
            }
          ]
        },
        {
          "type": "text",
          "text": "G4C-DONE"
        }
      ]
    }
  },
  {
    "id": "g4-d-mcp-resources-allow",
    "group": "4",
    "title": "MCP 资源工具 allow：list/read 到达 server",
    "task": "HOSTCOV G4-D mcp resources allow",
    "mcpServerName": "hostcov",
    "approvalPolicy": "ask",
    "rules": [
      {
        "id": "g4-res-list-allow",
        "tool": "list_mcp_resources",
        "contains": "hostcov",
        "action": "allow"
      },
      {
        "id": "g4-res-read-allow",
        "tool": "read_mcp_resource",
        "contains": "hostcov",
        "action": "allow"
      }
    ],
    "scenario": {
      "default": [
        {
          "type": "calls",
          "calls": [
            {
              "name": "list_mcp_resources",
              "arguments": {
                "server": "hostcov"
              }
            },
            {
              "name": "read_mcp_resource",
              "arguments": {
                "server": "hostcov",
                "uri": "hostcov://fixture/alpha"
              }
            }
          ]
        },
        {
          "type": "text",
          "text": "G4D-DONE"
        }
      ]
    }
  },
  {
    "id": "g4-e-mcp-resources-deny",
    "group": "4",
    "title": "MCP 资源 read deny：server 未收到 resources/read",
    "task": "HOSTCOV G4-E mcp resources deny",
    "mcpServerName": "hostcov",
    "approvalPolicy": "ask",
    "rules": [
      {
        "id": "g4-res-read-deny",
        "tool": "read_mcp_resource",
        "contains": "hostcov",
        "action": "deny",
        "reason": "hostcov fixture: resource read denied"
      }
    ],
    "scenario": {
      "default": [
        {
          "type": "calls",
          "calls": [
            {
              "name": "read_mcp_resource",
              "arguments": {
                "server": "hostcov",
                "uri": "hostcov://fixture/alpha"
              }
            }
          ]
        },
        {
          "type": "text",
          "text": "G4E-DONE"
        }
      ]
    }
  }
]