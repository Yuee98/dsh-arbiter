[
  {
    "id": "g5-a-spawn-child-allow",
    "group": "5",
    "title": "spawn 子任务内测试工具 allow：子会话身份与父会话关联",
    "task": "HOSTCOV G5-PARENT-A delegate spawn",
    "approvalPolicy": "ask",
    "rules": [
      {
        "id": "g5-spawn-allow",
        "tool": "bash",
        "contains": "G5-SPAWN-ALLOW",
        "action": "allow"
      }
    ],
    "scenario": {
      "default": [
        {
          "type": "calls",
          "calls": [
            {
              "name": "subagent",
              "arguments": {
                "description": "g5 spawn child",
                "prompt": "HOSTCOV-CHILD G5 run the marker command"
              }
            }
          ]
        },
        {
          "type": "text",
          "text": "G5A-PARENT-DONE"
        }
      ],
      "routes": [
        {
          "match": "HOSTCOV-CHILD G5",
          "steps": [
            {
              "type": "calls",
              "calls": [
                {
                  "name": "bash",
                  "arguments": {
                    "command": "printf 'G5-SPAWN-ALLOW\\n' > child-marker.txt; echo child-body-ran",
                    "description": "child marker"
                  }
                }
              ]
            },
            {
              "type": "text",
              "text": "G5-CHILD-DONE"
            }
          ]
        }
      ]
    },
    "markers": {
      "childMarker": "child-marker.txt"
    }
  },
