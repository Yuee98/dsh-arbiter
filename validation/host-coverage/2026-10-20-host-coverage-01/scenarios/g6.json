[
  {
    "id": "g6-a-workflow-tool-deny",
    "group": "6",
    "title": "workflow 工具入口 deny：脚本未启动，子任务未创建",
    "task": "HOSTCOV G6-A workflow tool deny",
    "approvalPolicy": "ask",
    "rules": [
      {
        "id": "g6-workflow-deny",
        "tool": "workflow",
        "contains": "G6-WORKFLOW-MARK",
        "action": "deny",
        "reason": "hostcov fixture: workflow tool denied"
      }
    ],
    "scenario": {
      "default": [
        {
          "type": "calls",
          "calls": [
            {
              "name": "workflow",
              "arguments": {
                "script": "\nconst result = await agent(\"HOSTCOV-CHILD G6 run the workflow marker command\", { label: \"g6 child\", phase: \"test\" });\nreturn { childText: result };\n\n// G6-WORKFLOW-MARK\n",
                "meta": {
                  "name": "g6-deny",
                  "description": "g6 deny probe"
                }
              }
            }
          ]
        },
        {
          "type": "text",
          "text": "G6A-DONE"
        }
      ],
      "routes": [
        {
          "match": "HOSTCOV-CHILD G6",
          "steps": [
            {
              "type": "calls",
              "calls": [
                {
                  "name": "bash",
                  "arguments": {
                    "command": "printf 'G6-WORKFLOW-INNER\\n' > workflow-inner.txt; echo workflow-child-body",
                    "description": "workflow child marker"
                  }
                }
              ]
            },
            {
              "type": "text",
              "text": "G6-CHILD-DONE"
            }
          ]
        }
      ]
    },
    "markers": {
      "inner": "workflow-inner.txt"
    }
  },
