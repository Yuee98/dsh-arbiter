  {
    "id": "g6-d-workflow-vs-direct-delegation",
    "group": "6",
    "title": "同一会话先直调 subagent 再用 workflow：比较委派工具门禁记录",
    "task": "HOSTCOV G6-D visibility control",
    "approvalPolicy": "ask",
    "rules": [
      {
        "id": "g6d-subagent-allow",
        "tool": "subagent",
        "contains": "G6D-DIRECT",
        "action": "allow"
      },
      {
        "id": "g6d-workflow-allow",
        "tool": "workflow",
        "contains": "G6-WORKFLOW-MARK",
        "action": "allow"
      },
      {
        "id": "g6d-inner-allow",
        "tool": "bash",
        "contains": "G6D-INNER",
        "action": "allow"
      }
    ],
    "scenario": {
      "default": [
        {
          "type": "calls",
          "calls": [
            {
              "name": "subagent",
              "arguments": {
                "description": "g6d direct child",
                "prompt": "HOSTCOV-CHILD G6D-DIRECT run the marker"
              }
            }
          ]
        },
        {
          "type": "calls",
          "calls": [
            {
              "name": "workflow",
              "arguments": {
                "script": "const out = await agent(\"HOSTCOV-CHILD G6D-WORKFLOW run the marker\", { label: \"g6d wf child\" });\nreturn { out };\n// G6-WORKFLOW-MARK\n",
                "meta": {
                  "name": "g6d-visibility",
                  "description": "g6d visibility control"
                }
              }
            }
          ]
        },
        {
          "type": "text",
          "text": "G6D-DONE"
        }
      ],
      "routes": [
        {
          "match": "HOSTCOV-CHILD G6D-DIRECT",
          "steps": [
            {
              "type": "calls",
              "calls": [
                {
                  "name": "bash",
                  "arguments": {
                    "command": "printf 'G6D-INNER direct\\n' > direct-inner.txt; echo direct-child",
                    "description": "direct child marker"
                  }
                }
              ]
            },
            {
              "type": "text",
              "text": "G6D-DIRECT-DONE"
            }
          ]
        },
        {
          "match": "HOSTCOV-CHILD G6D-WORKFLOW",
          "steps": [
            {
              "type": "calls",
              "calls": [
                {
                  "name": "bash",
                  "arguments": {
                    "command": "printf 'G6D-INNER workflow\\n' > workflow-inner.txt; echo workflow-child",
                    "description": "workflow child marker"
                  }
                }
              ]
            },
            {
              "type": "text",
              "text": "G6D-WORKFLOW-DONE"
            }
          ]
        }
      ]
    },
    "markers": {
      "direct": "direct-inner.txt",
      "workflow": "workflow-inner.txt"
    }
  }
]