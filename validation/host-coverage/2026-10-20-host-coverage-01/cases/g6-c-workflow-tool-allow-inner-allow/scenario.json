{
  "default": [
    {
      "type": "calls",
      "calls": [
        {
          "name": "workflow",
          "arguments": {
            "script": "\nconst result = await agent(\"HOSTCOV-CHILD G6 run the workflow marker command\", { label: \"g6 child\", phase: \"test\" });\nreturn { childText: result };\n\n// G6-WORKFLOW-MARK\n",
            "meta": {
              "name": "g6-inner-allow",
              "description": "g6 inner allow probe"
            }
          }
        }
      ]
    },
    {
      "type": "text",
      "text": "G6C-DONE"
    }
  ],
  "routes": [
    {
      "match": "HOSTCOV-CHILD G6",
      "steps": [
        {
          "type": "calls",
          "calls": [
            {
              "name": "bash",
              "arguments": {
                "command": "printf 'G6-INNER-ALLOW\\n' > workflow-inner.txt; echo workflow-child-body",
                "description": "workflow child marker"
              }
            }
          ]
        },
        {
          "type": "text",
          "text": "G6-CHILD-DONE"
        }
      ]
    }
  ]
}