{
  "default": [
    {
      "type": "calls",
      "calls": [
        {
          "name": "subagent_fork",
          "arguments": {
            "description": "g5 fork child",
            "prompt": "HOSTCOV-CHILD G5-FORK run the marker command"
          }
        }
      ]
    },
    {
      "type": "text",
      "text": "G5C-PARENT-DONE"
    }
  ],
  "routes": [
    {
      "match": "HOSTCOV-CHILD G5-FORK",
      "steps": [
        {
          "type": "calls",
          "calls": [
            {
              "name": "bash",
              "arguments": {
                "command": "printf 'G5-FORK-DENY\\n' > fork-marker.txt; echo fork-body-ran",
                "description": "fork marker"
              }
            }
          ]
        },
        {
          "type": "text",
          "text": "G5-FORK-DONE"
        }
      ]
    }
  ]
}