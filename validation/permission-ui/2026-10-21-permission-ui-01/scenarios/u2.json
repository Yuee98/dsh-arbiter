{
  "routes": [
    { "match": "U2BASELINE", "steps": [
      { "type": "calls", "calls": [ { "name": "bash", "arguments": { "command": "printf 'PUI-ALLOW baseline\\n' > '{{WS}}/u2-baseline.txt'", "description": "baseline allow" } } ] },
      { "type": "text", "text": "U2BASELINE-DONE" }
    ]},
    { "match": "U2DENY", "steps": [
      { "type": "calls", "calls": [ { "name": "bash", "arguments": { "command": "printf 'PUI-DENY after-exit\\n' > '{{WS}}/u2-deny.txt'", "description": "deny after exit" } } ] },
      { "type": "text", "text": "U2DENY-DONE" }
    ]},
    { "match": "U2AUTO", "steps": [
      { "type": "calls", "calls": [ { "name": "bash", "arguments": { "command": "printf 'PUI-ALLOW auto\\n' > '{{WS}}/u2-auto.txt'", "description": "after auto" } } ] },
      { "type": "text", "text": "U2AUTO-DONE" }
    ]},
    { "match": "U2ALLOWZ", "steps": [
      { "type": "calls", "calls": [ { "name": "bash", "arguments": { "command": "printf 'PUI-ALLOW z\\n' > '{{WS}}/u2-allowz.txt'", "description": "control allow" } } ] },
      { "type": "text", "text": "U2ALLOWZ-DONE" }
    ]}
  ],
  "default": [ { "type": "text", "text": "IDLE" } ]
}
