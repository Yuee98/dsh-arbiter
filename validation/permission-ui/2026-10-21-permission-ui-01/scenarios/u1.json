{
  "routes": [
    { "match": "U1ALLOWA", "steps": [
      { "type": "calls", "calls": [ { "name": "write", "arguments": { "file_path": "{{WS}}/guarded-allow.txt", "content": "guarded allow\n" } } ] },
      { "type": "text", "text": "U1ALLOWA-DONE" }
    ]},
    { "match": "U1DENYB", "steps": [
      { "type": "calls", "calls": [ { "name": "bash", "arguments": { "command": "printf 'PUI-DENY in workspace\\n' > '{{WS}}/guarded-deny.txt'", "description": "guarded deny" } } ] },
      { "type": "text", "text": "U1DENYB-DONE" }
    ]},
    { "match": "U1OUTSIDEC", "steps": [
      { "type": "calls", "calls": [ { "name": "write", "arguments": { "file_path": "{{OUTSIDE}}/guarded-outside.txt", "content": "outside guarded\n" } } ] },
      { "type": "text", "text": "U1OUTSIDEC-DONE" }
    ]},
    { "match": "U1TRUSTEDD", "steps": [
      { "type": "calls", "calls": [ { "name": "write", "arguments": { "file_path": "{{OUTSIDE}}/trusted-outside.txt", "content": "outside trusted\n" } } ] },
      { "type": "text", "text": "U1TRUSTEDD-DONE" }
    ]},
    { "match": "U1NEWSESSIONE", "steps": [
      { "type": "calls", "calls": [ { "name": "bash", "arguments": { "command": "printf 'PUI-DENY second\\n' > '{{WS}}/second-ws-deny.txt'", "description": "second session deny" } } ] },
      { "type": "text", "text": "U1NEWSESSIONE-DONE" }
    ]}
  ],
  "default": [ { "type": "text", "text": "IDLE" } ]
}
