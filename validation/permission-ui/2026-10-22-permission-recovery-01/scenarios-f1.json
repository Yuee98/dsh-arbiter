{
  "routes": [
    { "match": "F1RESEARCH", "steps": [
      { "type": "calls", "calls": [ { "name": "bash", "arguments": { "command": "printf 'F1 deny probe\\n' > '{{WS}}/f1-deny.txt'", "description": "deny probe" } } ] },
      { "type": "text", "text": "F1RESEARCH-DONE" }
    ]},
    { "match": "F1ALLOW", "steps": [
      { "type": "calls", "calls": [ { "name": "write", "arguments": { "file_path": "{{WS}}/f1-allow.txt", "content": "allow\n" } } ] },
      { "type": "text", "text": "F1ALLOW-DONE" }
    ]}
  ],
  "default": [ { "type": "text", "text": "IDLE" } ],
  "reviewerDefault": { "risk": 2, "authorized": 6, "secrets": false, "destructive": false, "egress": false, "bulk": false }
}
