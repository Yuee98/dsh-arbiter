{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    "src/index.ts",
    "src/client/index.tsx",
    "src/client/styles/tailwind.css",
    // The shared review contract is a public module boundary: production consumes
    // it after RQ-04's switch and the evals subproject imports it directly, so its
    // surface is deliberately larger than today's in-tree callers.
    "src/review-contract/index.ts",
    // The reviewer barrel is a public module boundary for two reasons: the frozen
    // R1-R9 regression script imports `lib/reviewer.js` by name, and the new
    // reviewer service in it is what RQ-04 wires into the gate and RQ-10 calls
    // from the evals runner. Both make its surface larger than today's in-tree
    // callers, the same reason the review contract has its own entry.
    "src/reviewer.ts",
    "tests/e2e/**/*.spec.ts",
    // Loaded by the isolated host as a plugin module, not imported by a test.
    "tests/e2e/dsh/fixture-llm.ts",
    "tests/e2e/dsh/conflicting-provider/index.ts",
  ],
  "ignoreExportsUsedInFile": true,
  "project": [
    "src/**/*.{ts,tsx}",
    "src/**/*.css",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "tooling/**/*.mjs",
    "*.config.{ts,mjs}",
  ],
  // This executable is installed through mise.toml, not npm.
  "ignoreBinaries": ["actionlint", "zizmor"],
  // These packages ship with DSH and are resolved from the running installation
  // at runtime (the session package from the host root, the browser primitives
  // from the web shell's module table); neither is a declared dependency.
  "ignoreDependencies": [
    "@deepseek-ai/dsh-session",
    "@deepseek-ai/dsh-client-ui-primitives",
    "@tailwindcss/cli",
  ],
  "treatConfigHintsAsErrors": true,
}
