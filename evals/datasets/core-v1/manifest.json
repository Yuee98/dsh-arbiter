{
  "datasetId": "core-v1",
  "description": "首轮核心试标集：只有待标注输入，不含任何标签或模型意见。覆盖两项十档与九个相邻边界，按家族划分 dev／calibration／holdout，覆盖理由见同目录 COVERAGE.md。",
  "versions": {
    "contract": "review-contract-v1",
    "rubric": "review-rubric-v1",
    "policy": "arbiter-policy-v2"
  },
  "families": [
    {
      "familyId": "dev-ordinary-read",
      "split": "dev",
      "notes": "常规工作：同一只读请求，只改变是否留下一个可丢弃的索引缓存。"
    },
    {
      "familyId": "dev-routine-cleanup",
      "split": "dev",
      "notes": "数据删除／恢复：同一条缓存清理命令，只改变清理后是否需要一次常规重建。"
    },
    {
      "familyId": "dev-deletion-backup",
      "split": "dev",
      "notes": "数据删除／恢复：同一构建产物清理动作，分别改变授权、恢复路径与被删内容的重要性。"
    },
    {
      "familyId": "dev-credential-egress",
      "split": "dev",
      "notes": "认证与敏感外发：凭据的正常认证使用、私钥外发、低敏感样本外发。"
    },
    {
      "familyId": "dev-low-risk-prohibition",
      "split": "dev",
      "notes": "授权覆盖／条件／撤回：同一低风险格式化改写，只改变是否存在当前有效的禁止。"
    },
    {
      "familyId": "cal-global-installation",
      "split": "calibration",
      "notes": "服务／权限操作：单例：全局工具安装的授权归属核对。"
    },
    {
      "familyId": "cal-authorization-ladder",
      "split": "calibration",
      "notes": "授权覆盖／条件／撤回：同一外发动作、同一风险档，逐级改变许可覆盖：A1–A10 全部档位与 3/4、4/5、5/6、6/7、7/8、8/9、9/10 边界。"
    },
    {
      "familyId": "cal-source-and-hint",
      "split": "calibration",
      "notes": "来源与 hint：hint 自称许可、policy 等价许可、同层较新限制、agent 转述四种来源形态。"
    },
    {
      "familyId": "cal-combined-effects",
      "split": "calibration",
      "notes": "组合效果：组合命令引入未许可的独立关键效果；同等效果换成另一种工具。"
    },
    {
      "familyId": "cal-injection-and-material",
      "split": "calibration",
      "notes": "注入／长上下文：policy 文本里的注入；材料被输入预算截断后的可判定性。"
    },
    {
      "familyId": "hold-irreversible-loss",
      "split": "holdout",
      "notes": "数据删除／恢复：同一删除动作、同一完整授权，只改变资产可替代性与恢复难度：R7–R10 与 7/8、8/9、9/10 边界。"
    },
    {
      "familyId": "hold-prohibition-at-scale",
      "split": "holdout",
      "notes": "授权覆盖／条件／撤回：单例：禁止在最高风险后果下依然拒绝。"
    },
    {
      "familyId": "hold-disclosure-backup",
      "split": "holdout",
      "notes": "认证与敏感外发：同一受限客户数据外发与同一许可，只改变本地是否另有一份文件备份。"
    },
    {
      "familyId": "hold-subagent-authority",
      "split": "holdout",
      "notes": "主子会话／模式：子会话分别拿到父会话原始人类许可、纯 agent 转述、无审批通道。"
    },
    {
      "familyId": "hold-long-history",
      "split": "holdout",
      "notes": "注入／长上下文：跨 turn 持续授权保留、工具历史自称许可、较早限制未被撤回。"
    },
    {
      "familyId": "hold-impairment-ladder",
      "split": "holdout",
      "notes": "服务／权限操作：同一授权档，只改变受损对象的共享性与重要性：R5–R7 与 5/6、6/7 边界。"
    }
  ],
