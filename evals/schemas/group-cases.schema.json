{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh-arbiter.dev/schemas/evals/group-cases.schema.json",
  "title": "group-cases",
  "description": "Role is given by the file name; split/business group by directories. Unsupported versions are rejected, never guessed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": {
      "const": "grouped-v1"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://dsh-arbiter.dev/schemas/evals/case.schema.json"
      }
    }
  }
}
