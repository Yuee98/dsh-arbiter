{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dsh-arbiter.dev/schemas/evals/run-common.schema.json",
  "title": "Evals run shared definitions",
  "description": "The values the run documents share. A definition file has no document of its own: the plan, the run index, the cell record and the fixture reference into it, so one member cannot mean two things in two files. Scoring vocabulary is not redefined here — `outcome` and `scoreTrail` restate the shape the shared review contract already publishes, because a stored record has to be readable by a report that does not share this module's code.",
  "definitions": {
    "instant": {
      "description": "An ISO 8601 instant in UTC with milliseconds. Attempt timestamps keep the production adapter's own epoch milliseconds instead; those are values the adapter reported and are not reformatted here.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "cellId": {
      "description": "case, target, protocol and repeat in one filesystem-safe name. The shape is derivable, so a reader can find a cell's record without reading the index first.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._~-]{0,179}$"
    },
    "nullableCount": {
      "description": "A count, or null when it was not reported. Null is never zero: zero is a value a provider can report, and the two mean different things.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "chatTarget": {
      "description": "The chat transport's own configuration, in the production type's shape. `provider` `session` is resolved from the host and refused outside one, so a plan that must run headless names a concrete route.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "temperature",
        "maxTokens",
        "timeoutMs",
        "maxRepairRetries"
      ],
      "properties": {
        "provider": {
          "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/text"
        },
        "model": {
          "type": "string"
        },
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxRepairRetries": {
          "type": "integer",
          "minimum": 0
        },
        "reasoningEffort": {
          "type": "string"
        }
      }
    },
    "decisionTarget": {
      "description": "The decision transport's own configuration. `apiKeyRef` names the credential, never carries it: the resolved value appears in no artifact, and the production adapter masks whatever it sent.",
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "model", "apiKeyRef", "timeoutMs", "costTier"],
      "properties": {
        "url": {
          "type": "string"
        },
        "model": {
          "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/text"
        },
        "apiKeyRef": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "costTier": {
          "type": "string",
          "enum": ["free", "paid"]
        }
      }
    },
    "target": {
      "description": "One model, through the protocols it actually supports. An unsupported protocol is null, and that grid cell is then recorded as unsupported instead of being filled with an invented request.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "provider",
        "model",
        "modelVersion",
        "chat",
        "decision",
        "credentialRef"
      ],
      "properties": {
        "targetId": {
          "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/slug"
        },
        "provider": {
          "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/text"
        },
        "model": {
          "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/text"
        },
        "modelVersion": {
          "anyOf": [
            {
              "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "chat": {
          "anyOf": [
            {
              "$ref": "#/definitions/chatTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/definitions/decisionTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "credentialRef": {
          "description": "Name of the environment variable a live run resolves the credential from. The value itself is never stored.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "bounds": {
      "description": "The ceilings the runner enforces. maxAttempts bounds model attempts across the whole run, reserved before each dispatch so a repair loop cannot spend an unbounded budget; maxInputTokens bounds what may be sent at all.",
      "type": "object",
      "additionalProperties": false,
      "required": ["concurrency", "timeoutMs", "maxAttempts", "maxInputTokens"],
      "properties": {
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "maxInputTokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "versions": {
      "description": "What produced one cell. A reader compares runs by all four semantic versions: the contract, the prompt, the usage mapping and the plan decide what a recorded number means.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "prompt",
        "usageMapping",
        "plan",
        "artifact",
        "implementation"
      ],
      "properties": {
        "contract": {
          "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/text"
        },
        "prompt": {
          "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/text"
        },
        "usageMapping": {
          "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/text"
        },
        "plan": {
          "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/text"
        },
        "artifact": {
          "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/text"
        },
        "implementation": {
          "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/text"
        },
        "node": {
          "description": "The Node.js version that ran it. Recorded because a runtime change can change token estimation. Present on a run's own versions, absent from a record that inherits its run's.",
          "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/text"
        }
      }
    },
    "scoreTrail": {
      "description": "How one band was reached. `native` is the protocol's own distribution (null for chat), `published` is the same mass re-keyed to the public scale, `point` is the chat integer (null for a distribution).",
      "type": "object",
      "additionalProperties": false,
      "required": ["native", "published", "point", "score"],
      "properties": {
        "native": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "published": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "point": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/publicScore"
        }
      }
    },
    "outcome": {
      "description": "The three shared outcomes, stored as the shared contract produced them. The scored branch carries the matrix result; the other two carry no score of their own, and any partial trails they report are diagnostic only.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "source",
            "risk",
            "authorization",
            "requiredAuthorization",
            "verdict",
            "audit"
          ],
          "properties": {
            "status": {
              "const": "scored"
            },
            "source": {
              "type": "string",
              "enum": ["chat", "decision"]
            },
            "risk": {
              "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/publicScore"
            },
            "authorization": {
              "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/publicScore"
            },
            "requiredAuthorization": {
              "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/publicScore"
            },
            "verdict": {
              "type": "string",
              "enum": ["review-allow", "review-deny", "review-escalate"]
            },
            "audit": {
              "type": "object",
              "additionalProperties": false,
              "required": ["risk", "authorization"],
              "properties": {
                "risk": {
                  "$ref": "#/definitions/scoreTrail"
                },
                "authorization": {
                  "$ref": "#/definitions/scoreTrail"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "gaps", "reason", "diagnostic"],
          "properties": {
            "status": {
              "const": "insufficient-material"
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "reason"],
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            },
            "reason": {
              "type": "string"
            },
            "diagnostic": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["risk", "authorization"],
                  "properties": {
                    "risk": {
                      "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/publicScore"
                    },
                    "authorization": {
                      "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/publicScore"
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "failures", "reason", "diagnostic"],
          "properties": {
            "status": {
              "const": "review-failure"
            },
            "failures": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["field", "reason", "detail"],
                "properties": {
                  "field": {
                    "type": "string",
                    "enum": ["risk", "authorization"]
                  },
                  "reason": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  }
                }
              }
            },
            "reason": {
              "type": "string"
            },
            "diagnostic": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["risk", "authorization"],
                  "properties": {
                    "risk": {
                      "anyOf": [
                        {
                          "$ref": "#/definitions/scoreTrail"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "authorization": {
                      "anyOf": [
                        {
                          "$ref": "#/definitions/scoreTrail"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "tokenCounts": {
      "description": "The six buckets the shared mapping produces. A null bucket was not reported; a zero bucket was reported as zero.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTokens",
        "outputTokens",
        "totalTokens",
        "cacheReadTokens",
        "cacheWriteTokens",
        "reasoningTokens"
      ],
      "properties": {
        "inputTokens": {
          "$ref": "#/definitions/nullableCount"
        },
        "outputTokens": {
          "$ref": "#/definitions/nullableCount"
        },
        "totalTokens": {
          "$ref": "#/definitions/nullableCount"
        },
        "cacheReadTokens": {
          "$ref": "#/definitions/nullableCount"
        },
        "cacheWriteTokens": {
          "$ref": "#/definitions/nullableCount"
        },
        "reasoningTokens": {
          "$ref": "#/definitions/nullableCount"
        }
      }
    },
    "inclusion": {
      "description": "How a sub-count relates to its parent. `contained` means adding it would double-count, `separate` means it sits beside the parent, `unknown` means this payload does not establish either.",
      "type": "string",
      "enum": ["contained", "separate", "unknown"]
    },
    "inclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cacheRead", "cacheWrite", "reasoning"],
      "properties": {
        "cacheRead": {
          "$ref": "#/definitions/inclusion"
        },
        "cacheWrite": {
          "$ref": "#/definitions/inclusion"
        },
        "reasoning": {
          "$ref": "#/definitions/inclusion"
        }
      }
    },
    "normalizedUsage": {
      "description": "One provider payload under the shared mapping. `raw` is the payload as the adapter already masked it, copied rather than rebuilt, so a stored record can be re-normalized after the mapping version changes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mappingVersion",
        "source",
        "tokens",
        "inclusions",
        "sources",
        "ignored",
        "raw"
      ],
      "properties": {
        "mappingVersion": {
          "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/text"
        },
        "source": {
          "type": "string",
          "enum": ["chat", "decision"]
        },
        "tokens": {
          "$ref": "#/definitions/tokenCounts"
        },
        "inclusions": {
          "$ref": "#/definitions/inclusions"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "path"],
            "properties": {
              "field": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        },
        "ignored": {
          "description": "Paths that were present but held no usable count. Recorded rather than dropped, so a provider that changes a field's type is visible.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "raw": {}
      }
    },
    "fieldTotal": {
      "description": "One bucket's sum and how much of the attempt set it covers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "reported", "missing", "complete"],
      "properties": {
        "total": {
          "$ref": "#/definitions/nullableCount"
        },
        "reported": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "usageAggregate": {
      "description": "A cell's usage over its actual attempts, from the shared aggregate. `totals` never presents a partial sum as a whole: `missing` says how many attempts did not report the bucket.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mappingVersion",
        "attempts",
        "withUsage",
        "duplicateAttempts",
        "totals",
        "inclusions"
      ],
      "properties": {
        "mappingVersion": {
          "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/text"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "withUsage": {
          "type": "integer",
          "minimum": 0
        },
        "duplicateAttempts": {
          "type": "integer",
          "minimum": 0
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputTokens",
            "outputTokens",
            "totalTokens",
            "cacheReadTokens",
            "cacheWriteTokens",
            "reasoningTokens"
          ],
          "properties": {
            "inputTokens": {
              "$ref": "#/definitions/fieldTotal"
            },
            "outputTokens": {
              "$ref": "#/definitions/fieldTotal"
            },
            "totalTokens": {
              "$ref": "#/definitions/fieldTotal"
            },
            "cacheReadTokens": {
              "$ref": "#/definitions/fieldTotal"
            },
            "cacheWriteTokens": {
              "$ref": "#/definitions/fieldTotal"
            },
            "reasoningTokens": {
              "$ref": "#/definitions/fieldTotal"
            }
          }
        },
        "inclusions": {
          "$ref": "#/definitions/inclusions"
        }
      }
    },
    "attempt": {
      "description": "One actual model attempt as the production adapter reported it, after that adapter masked every credential it knows it sent. `kind` separates the plan's first attempt from the transport's own format repair: both are real attempts and both count, and neither is an independent repeat.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptId",
        "callId",
        "attempt",
        "kind",
        "backend",
        "protocol",
        "request",
        "responseText",
        "parsed",
        "error",
        "failureKind",
        "startedAt",
        "durationMs",
        "estimatedInputTokens",
        "rawUsage",
        "normalizedUsage"
      ],
      "properties": {
        "attemptId": {
          "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/text"
        },
        "callId": {
          "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/text"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "description": "initial is the attempt the plan asked for; repair is the transport's own re-ask after an unreadable answer. A repair is never a repeat.",
          "type": "string",
          "enum": ["initial", "repair"]
        },
        "backend": {
          "type": "string",
          "enum": ["chat", "decision"]
        },
        "protocol": {
          "$ref": "https://dsh-arbiter.dev/schemas/evals/common.schema.json#/definitions/text"
        },
        "request": {},
        "responseText": {
          "description": "The complete response body this adapter received, already masked. Null means no body arrived at all.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "parsed": {},
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "failureKind": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["provider-refusal", "unreadable-answer", "transport"]
            },
            {
              "type": "null"
            }
          ]
        },
        "startedAt": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "estimatedInputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "rawUsage": {
          "description": "The provider's usage payload, already masked, exactly as received. Null means the provider reported nothing, which is not a payload of zeros."
        },
        "normalizedUsage": {
          "anyOf": [
            {
              "$ref": "#/definitions/normalizedUsage"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
